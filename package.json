{
  "name": "obsidian-wechat-multi-publisher",
  "version": "2.3.2",
  "description": "Publish Markdown notes to multiple WeChat Official Accounts.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "wechat",
    "multi-account",
    "official-account"
  ],
  "author": "Kianzzz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kianzzz/obsidian-wechat-publisher.git"
  },
  "bugs": "https://github.com/Kianzzz/obsidian-wechat-publisher/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "html2canvas": "^1.4.1",
    "https-proxy-agent": "^7.0.6",
    "marked": "^9.1.6",
    "postcss": "^8.5.19",
    "socks-proxy-agent": "^8.0.5"
  }
}
